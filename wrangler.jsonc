{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mulder",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-02",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "INTENTS", "class_name": "IntentDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IntentDurableObject"] }
  ]
}
